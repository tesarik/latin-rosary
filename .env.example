# Sub-path the app is served under. Must start AND end with a slash.
# Examples:
#   /                  -> https://example.com/
#   /latin-rosary/     -> https://www.jaroslavtesarik.cz/latin-rosary/
#
# Copy this file to .env (or .env.local for dev-only) and uncomment:
# BASE_PATH=/latin-rosary/

# Origin the app is served from, no trailing slash. Combined with BASE_PATH it
# gives the absolute URLs that link previews (Open Graph) and the prayer pages'
# canonical links need, and enables sitemap.xml.
# SITE_URL=https://jaroslavtesarik.cz
