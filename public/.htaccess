# rosarium.lat only at https://rosarium.lat/: plain http and www get a 301
# there (the service worker needs https, and localStorage is per origin).
# WEDOS serves each domain from domains/<domain>/ through an internal rewrite,
# so %{REQUEST_URI} holds that folder: the path is taken relative to this file
# ($1), and a request naming the folder itself is sent back to the plain path.
RewriteEngine On
RewriteCond %{THE_REQUEST} \s/domains/rosarium\.lat/(\S*)\s
RewriteRule ^ https://rosarium.lat/%1 [R=301,L,NE]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://rosarium.lat/$1 [R=301,L,NE]
